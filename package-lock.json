{
  "name": "ai-workplace-learning-platform",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ai-workplace-learning-platform",
      "workspaces": [
        "backend",
        "frontend",
        "worker",
        "packages/*"
      ]
    },
    "backend": {
      "version": "1.0.0"
    },
    "frontend": {
      "version": "1.0.0"
    },
    "node_modules/@ai-workplace-learning/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/backend": {
      "resolved": "backend",
      "link": true
    },
    "node_modules/frontend": {
      "resolved": "frontend",
      "link": true
    },
    "node_modules/worker": {
      "resolved": "worker",
      "link": true
    },
    "packages/shared": {
      "name": "@ai-workplace-learning/shared",
      "version": "1.0.0"
    },
    "worker": {
      "version": "1.0.0"
    }
  }
}
